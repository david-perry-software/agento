{
  "name": "agento-dashboard",
  "displayName": "Agento",
  "description": "Dashboard and command launcher for Agento delivery workflows.",
  "version": "0.14.0",
  "type": "module",
  "publisher": "david-perry-software",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/david-perry-software/agento.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agento",
          "title": "Agento",
          "icon": "media/agento.svg"
        }
      ]
    },
    "views": {
      "agento": [
        {
          "id": "agento.windowBanner",
          "name": "Window",
          "type": "webview",
          "initialSize": 1
        },
        {
          "id": "agento.deliveries",
          "name": "Deliveries"
        },
        {
          "id": "agento.initiatives",
          "name": "Initiatives"
        },
        {
          "id": "agento.sessionDoctor",
          "name": "Session & Doctor"
        },
        {
          "id": "agento.modelProfiles",
          "name": "Model Profiles"
        }
      ]
    },
    "commands": [
      {
        "command": "agento.refresh",
        "title": "Refresh",
        "category": "Agento"
      },
      {
        "command": "agento.showOutput",
        "title": "Show Output",
        "category": "Agento"
      },
      {
        "command": "agento.openRoadmap",
        "title": "Open Roadmap",
        "category": "Agento"
      },
      {
        "command": "agento.openBreakdown",
        "title": "Open Breakdown",
        "category": "Agento"
      },
      {
        "command": "agento.newPlan",
        "title": "New Plan",
        "category": "Agento",
        "icon": "$(add)"
      },
      {
        "command": "agento.newInitiative",
        "title": "New Initiative",
        "category": "Agento",
        "icon": "$(add)"
      },
      {
        "command": "agento.planInitiativeMember",
        "title": "Plan",
        "category": "Agento",
        "icon": "$(play)"
      },
      {
        "command": "agento.showActions",
        "title": "Show Actions",
        "category": "Agento",
        "icon": "$(play)"
      },
      {
        "command": "agento.selectModelProfile",
        "title": "Select Model Profile",
        "category": "Agento"
      },
      {
        "command": "agento.modelProfiles.apply",
        "title": "Use Here",
        "category": "Agento",
        "icon": "$(check)"
      },
      {
        "command": "agento.modelProfiles.usePrimary",
        "title": "Use in Primary Windows",
        "category": "Agento",
        "icon": "$(check)"
      },
      {
        "command": "agento.modelProfiles.useSecondary",
        "title": "Use in Secondary Windows",
        "category": "Agento",
        "icon": "$(check)"
      },
      {
        "command": "agento.modelProfiles.offPrimary",
        "title": "Turn Off for Primary Windows",
        "category": "Agento",
        "icon": "$(circle-slash)"
      },
      {
        "command": "agento.modelProfiles.offSecondary",
        "title": "Turn Off for Secondary Windows",
        "category": "Agento",
        "icon": "$(circle-slash)"
      },
      {
        "command": "agento.modelProfiles.pickForRole",
        "title": "Pick for Role",
        "category": "Agento",
        "icon": "$(list-selection)"
      },
      {
        "command": "agento.modelProfiles.new",
        "title": "New Profile",
        "category": "Agento",
        "icon": "$(add)"
      },
      {
        "command": "agento.modelProfiles.clear",
        "title": "Turn Off for This Window's Role",
        "category": "Agento",
        "icon": "$(clear-all)"
      },
      {
        "command": "agento.modelProfiles.openFile",
        "title": "Open Profiles File",
        "category": "Agento",
        "icon": "$(go-to-file)"
      },
      {
        "command": "agento.modelProfiles.edit",
        "title": "Edit",
        "category": "Agento",
        "icon": "$(edit)"
      },
      {
        "command": "agento.editModelProfile",
        "title": "Edit Model Profile",
        "category": "Agento"
      },
      {
        "command": "agento.modelProfiles.duplicate",
        "title": "Duplicate",
        "category": "Agento",
        "icon": "$(copy)"
      },
      {
        "command": "agento.modelProfiles.rename",
        "title": "Rename",
        "category": "Agento",
        "icon": "$(pencil)"
      },
      {
        "command": "agento.modelProfiles.delete",
        "title": "Delete",
        "category": "Agento",
        "icon": "$(trash)"
      },
      {
        "command": "agento.modelProfiles.init",
        "title": "Create Profiles File",
        "category": "Agento",
        "icon": "$(new-file)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agento.refresh",
          "when": "view == agento.deliveries",
          "group": "navigation"
        },
        {
          "command": "agento.refresh",
          "when": "view == agento.initiatives",
          "group": "navigation"
        },
        {
          "command": "agento.refresh",
          "when": "view == agento.sessionDoctor",
          "group": "navigation"
        },
        {
          "command": "agento.newPlan",
          "when": "view == agento.deliveries && agento.canPlan",
          "group": "navigation@2"
        },
        {
          "command": "agento.newInitiative",
          "when": "view == agento.initiatives && agento.primary",
          "group": "navigation@2"
        },
        {
          "command": "agento.newPlan",
          "when": "view == agento.sessionDoctor && agento.canPlan",
          "group": "navigation@2"
        },
        {
          "command": "agento.showActions",
          "when": "view == agento.sessionDoctor",
          "group": "navigation@3"
        },
        {
          "command": "agento.modelProfiles.new",
          "when": "view == agento.modelProfiles",
          "group": "navigation@1"
        },
        {
          "command": "agento.modelProfiles.clear",
          "when": "view == agento.modelProfiles && agento.modelProfiles.state == ready",
          "group": "navigation@2"
        },
        {
          "command": "agento.refresh",
          "when": "view == agento.modelProfiles",
          "group": "navigation@3"
        },
        {
          "command": "agento.modelProfiles.openFile",
          "when": "view == agento.modelProfiles"
        }
      ],
      "view/item/context": [
        {
          "command": "agento.showActions",
          "when": "view == agento.deliveries && viewItem == agento.delivery",
          "group": "inline"
        },
        {
          "command": "agento.planInitiativeMember",
          "when": "view == agento.initiatives && viewItem == agento.initiativeMember.ready && agento.canPlan",
          "group": "inline"
        },
        {
          "command": "agento.showActions",
          "when": "view == agento.initiatives && viewItem == agento.initiativeMember.in-flight",
          "group": "inline"
        },
        {
          "command": "agento.modelProfiles.apply",
          "when": "view == agento.modelProfiles && viewItem =~ /^agento\\.modelProfile(\\.(primary|secondary|invalid))*$/",
          "group": "inline"
        },
        {
          "command": "agento.modelProfiles.usePrimary",
          "when": "view == agento.modelProfiles && viewItem =~ /^agento\\.modelProfile(\\.(secondary|here|invalid))*$/",
          "group": "0_roles@1"
        },
        {
          "command": "agento.modelProfiles.useSecondary",
          "when": "view == agento.modelProfiles && viewItem =~ /^agento\\.modelProfile(\\.(primary|here|invalid))*$/",
          "group": "0_roles@2"
        },
        {
          "command": "agento.modelProfiles.offPrimary",
          "when": "view == agento.modelProfiles && viewItem =~ /^agento\\.modelProfile\\.primary/",
          "group": "0_roles@3"
        },
        {
          "command": "agento.modelProfiles.offSecondary",
          "when": "view == agento.modelProfiles && viewItem =~ /^agento\\.modelProfile(\\.primary)?\\.secondary/",
          "group": "0_roles@4"
        },
        {
          "command": "agento.modelProfiles.offPrimary",
          "when": "view == agento.modelProfiles && viewItem == agento.modelRole.primary.on",
          "group": "inline"
        },
        {
          "command": "agento.modelProfiles.offSecondary",
          "when": "view == agento.modelProfiles && viewItem == agento.modelRole.secondary.on",
          "group": "inline"
        },
        {
          "command": "agento.modelProfiles.edit",
          "when": "view == agento.modelProfiles && viewItem =~ /^agento\\.modelProfile/",
          "group": "1_modify@1"
        },
        {
          "command": "agento.modelProfiles.duplicate",
          "when": "view == agento.modelProfiles && viewItem =~ /^agento\\.modelProfile/",
          "group": "1_modify@2"
        },
        {
          "command": "agento.modelProfiles.rename",
          "when": "view == agento.modelProfiles && viewItem =~ /^agento\\.modelProfile/",
          "group": "1_modify@3"
        },
        {
          "command": "agento.modelProfiles.delete",
          "when": "view == agento.modelProfiles && viewItem =~ /^agento\\.modelProfile/",
          "group": "1_modify@4"
        }
      ],
      "commandPalette": [
        {
          "command": "agento.newPlan",
          "when": "agento.canPlan"
        },
        {
          "command": "agento.newInitiative",
          "when": "agento.primary"
        },
        {
          "command": "agento.planInitiativeMember",
          "when": "false"
        },
        {
          "command": "agento.modelProfiles.apply",
          "when": "false"
        },
        {
          "command": "agento.modelProfiles.usePrimary",
          "when": "false"
        },
        {
          "command": "agento.modelProfiles.useSecondary",
          "when": "false"
        },
        {
          "command": "agento.modelProfiles.offPrimary",
          "when": "false"
        },
        {
          "command": "agento.modelProfiles.offSecondary",
          "when": "false"
        },
        {
          "command": "agento.modelProfiles.pickForRole",
          "when": "false"
        },
        {
          "command": "agento.modelProfiles.edit",
          "when": "false"
        },
        {
          "command": "agento.modelProfiles.duplicate",
          "when": "false"
        },
        {
          "command": "agento.modelProfiles.rename",
          "when": "false"
        },
        {
          "command": "agento.modelProfiles.delete",
          "when": "false"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agento.modelProfiles",
        "contents": "No model profiles file yet.\n[Create Profiles File](command:agento.modelProfiles.init)",
        "when": "agento.modelProfiles.state == no-file"
      },
      {
        "view": "agento.modelProfiles",
        "contents": "No Agento plugin clone found. Set agento.pluginRoot or register the clone in chat.pluginLocations.\n[Open Settings](command:workbench.action.openSettings?%5B%22agento.pluginRoot%22%5D)",
        "when": "agento.modelProfiles.state == no-plugin-root"
      }
    ],
    "configuration": {
      "title": "Agento",
      "properties": {
        "agento.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Node.js executable used to run the bundled Agento CLI."
        },
        "agento.refreshDebounceMs": {
          "type": "number",
          "default": 3000,
          "minimum": 3000,
          "description": "Delay in milliseconds before file changes refresh Agento state."
        },
        "agento.pluginRoot": {
          "type": "string",
          "default": "",
          "description": "Agento plugin clone that model profiles are applied to and the doctor's model-profile check reads. Empty: the first enabled chat.pluginLocations entry whose .claude-plugin/plugin.json is named agento."
        },
        "agento.chatModelPreselect": {
          "type": "string",
          "enum": [
            "off",
            "local",
            "copilot"
          ],
          "default": "off",
          "description": "Preselect the model for Agento-dispatched chat commands. off: no modelSelector (a banner hint and a log line name the model to pick by hand). local: send { vendor, id } for Local chat sessions. copilot: send { id: <Copilot id> } for Copilot chat sessions. A value that does not match the session type has side effects documented in the Agento docs."
        }
      }
    },
    "colors": [
      {
        "id": "agento.status.planned",
        "description": "Agento dashboard icon color for planned deliveries.",
        "defaults": {
          "dark": "charts.blue",
          "light": "charts.blue",
          "highContrast": "charts.blue",
          "highContrastLight": "charts.blue"
        }
      },
      {
        "id": "agento.status.building",
        "description": "Agento dashboard icon color for deliveries being built.",
        "defaults": {
          "dark": "charts.yellow",
          "light": "charts.yellow",
          "highContrast": "charts.yellow",
          "highContrastLight": "charts.yellow"
        }
      },
      {
        "id": "agento.status.paused",
        "description": "Agento dashboard icon color for paused deliveries.",
        "defaults": {
          "dark": "charts.orange",
          "light": "charts.orange",
          "highContrast": "charts.orange",
          "highContrastLight": "charts.orange"
        }
      },
      {
        "id": "agento.status.inReview",
        "description": "Agento dashboard icon color for deliveries in review.",
        "defaults": {
          "dark": "charts.purple",
          "light": "charts.purple",
          "highContrast": "charts.purple",
          "highContrastLight": "charts.purple"
        }
      },
      {
        "id": "agento.status.approved",
        "description": "Agento dashboard icon color for approved deliveries.",
        "defaults": {
          "dark": "charts.green",
          "light": "charts.green",
          "highContrast": "charts.green",
          "highContrastLight": "charts.green"
        }
      },
      {
        "id": "agento.status.shipped",
        "description": "Agento dashboard icon color for shipped deliveries.",
        "defaults": {
          "dark": "charts.green",
          "light": "charts.green",
          "highContrast": "charts.green",
          "highContrastLight": "charts.green"
        }
      },
      {
        "id": "agento.status.postShipPending",
        "description": "Agento dashboard icon color for shipped deliveries with post-ship steps pending.",
        "defaults": {
          "dark": "charts.orange",
          "light": "charts.orange",
          "highContrast": "charts.orange",
          "highContrastLight": "charts.orange"
        }
      },
      {
        "id": "agento.status.ready",
        "description": "Agento dashboard icon color for initiative members ready to plan.",
        "defaults": {
          "dark": "charts.blue",
          "light": "charts.blue",
          "highContrast": "charts.blue",
          "highContrastLight": "charts.blue"
        }
      },
      {
        "id": "agento.status.inFlight",
        "description": "Agento dashboard icon color for initiative members in flight.",
        "defaults": {
          "dark": "charts.yellow",
          "light": "charts.yellow",
          "highContrast": "charts.yellow",
          "highContrastLight": "charts.yellow"
        }
      },
      {
        "id": "agento.status.blocked",
        "description": "Agento dashboard icon color for blocked initiative members.",
        "defaults": {
          "dark": "charts.red",
          "light": "charts.red",
          "highContrast": "charts.red",
          "highContrastLight": "charts.red"
        }
      },
      {
        "id": "agento.status.complete",
        "description": "Agento dashboard icon color for complete initiatives and members.",
        "defaults": {
          "dark": "charts.green",
          "light": "charts.green",
          "highContrast": "charts.green",
          "highContrastLight": "charts.green"
        }
      },
      {
        "id": "agento.health.ok",
        "description": "Agento dashboard icon color for passing doctor checks.",
        "defaults": {
          "dark": "charts.green",
          "light": "charts.green",
          "highContrast": "charts.green",
          "highContrastLight": "charts.green"
        }
      },
      {
        "id": "agento.health.warn",
        "description": "Agento dashboard icon color for doctor and session warnings.",
        "defaults": {
          "dark": "charts.yellow",
          "light": "charts.yellow",
          "highContrast": "charts.yellow",
          "highContrastLight": "charts.yellow"
        }
      },
      {
        "id": "agento.health.fail",
        "description": "Agento dashboard icon color for failing checks, errors, and invalid initiatives.",
        "defaults": {
          "dark": "charts.red",
          "light": "charts.red",
          "highContrast": "charts.red",
          "highContrastLight": "charts.red"
        }
      },
      {
        "id": "agento.role.primary",
        "description": "Agento window banner background in the primary checkout.",
        "defaults": {
          "dark": "#0063B1",
          "light": "#0063B1",
          "highContrast": "#0063B1",
          "highContrastLight": "#0063B1"
        }
      },
      {
        "id": "agento.role.plan",
        "description": "Agento window banner background in plan worktrees.",
        "defaults": {
          "dark": "#7B2CBF",
          "light": "#7B2CBF",
          "highContrast": "#7B2CBF",
          "highContrastLight": "#7B2CBF"
        }
      },
      {
        "id": "agento.role.build",
        "description": "Agento window banner background in build worktrees.",
        "defaults": {
          "dark": "#1E7B34",
          "light": "#1E7B34",
          "highContrast": "#1E7B34",
          "highContrastLight": "#1E7B34"
        }
      },
      {
        "id": "agento.role.freehand",
        "description": "Agento window banner background in freehand worktrees.",
        "defaults": {
          "dark": "#00796B",
          "light": "#00796B",
          "highContrast": "#00796B",
          "highContrastLight": "#00796B"
        }
      },
      {
        "id": "agento.role.unmanaged",
        "description": "Agento window banner background in unmanaged checkouts, where delivery commands are disabled.",
        "defaults": {
          "dark": "#C62828",
          "light": "#C62828",
          "highContrast": "#C62828",
          "highContrastLight": "#C62828"
        }
      },
      {
        "id": "agento.role.unavailable",
        "description": "Agento window banner background when the session cannot be loaded.",
        "defaults": {
          "dark": "#5F6368",
          "light": "#5F6368",
          "highContrast": "#5F6368",
          "highContrastLight": "#5F6368"
        }
      },
      {
        "id": "agento.role.foreground",
        "description": "Agento window banner text color.",
        "defaults": {
          "dark": "#FFFFFF",
          "light": "#FFFFFF",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#FFFFFF"
        }
      }
    ]
  },
  "scripts": {
    "copy-cli": "node scripts/copy-cli.mjs",
    "build": "npm run copy-cli && tsc -p ./",
    "watch": "tsc -w -p ./",
    "typecheck": "tsc --noEmit -p ./",
    "test:unit": "npm run build && tsc -p tsconfig.test.json && node --test 'out/test/unit/**/*.test.js'",
    "test:electron": "npm run build && tsc -p tsconfig.test.json && node out/test/electron/runTest.js",
    "test:vsix": "tsc -p tsconfig.test.json && node out/test/vsix/runTest.js",
    "test": "npm run test:unit && npm run test:electron",
    "package": "vsce package --no-dependencies && node scripts/assert-vsix.mjs",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.125.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
